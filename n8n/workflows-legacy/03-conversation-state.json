        "jsCode": "const input = $json.body ?? $json;\nconst operations = new Set(['get', 'create', 'update']);\nif (!operations.has(input.operation)) throw new Error('operation must be get, create, or update');\nif (typeof input.conversation_id !== 'string' || input.conversation_id.trim() === '') throw new Error('conversation_id is required');\nconst intakeFields = ['unusedCapacity', 'targetReservations', 'maximumBudgetPaise', 'maximumDiscountPercent', 'maximumExpectedCpaPaise', 'startTime', 'endTime', 'missingFields'];\nconst collected = {};\nif (input.collected_fields && typeof input.collected_fields === 'object' && !Array.isArray(input.collected_fields)) {\n  for (const key of intakeFields) if (Object.prototype.hasOwnProperty.call(input.collected_fields, key)) collected[key] = input.collected_fields[key];\n}\nconst missing = Array.isArray(input.missing_fields) ? input.missing_fields.filter((field) => typeof field === 'string' && intakeFields.includes(field)) : [];\nif (input.operation !== 'get') {\n  if (typeof input.owner_handle !== 'string' || input.owner_handle.trim() === '') throw new Error('owner_handle is required');\n  if (typeof input.spot_id !== 'string' || input.spot_id.trim() === '') throw new Error('spot_id is required');\n}\nreturn [{ json: { operation: input.operation, conversation_id: input.conversation_id.trim(), owner_handle: typeof input.owner_handle === 'string' ? input.owner_handle.trim() : '', spot_id: typeof input.spot_id === 'string' ? input.spot_id.trim() : '', collected_fields_json: JSON.stringify(collected), missing_fields_json: JSON.stringify(missing), updated_at: new Date().toISOString() } }];"
