        "jsCode": "const event = $('Validate Normalized Event').item.json;\nconst stateResponse = $('Load Conversation State').item.json;\nconst state = stateResponse.data ?? null;\nlet existing = {};\ntry { existing = state?.collected_fields_json ? JSON.parse(state.collected_fields_json) : {}; } catch { existing = {}; }\nconst intent = $json;\nconst extractedMissing = new Set(Array.isArray(intent.missingFields) ? intent.missingFields : []);\nconst merged = { ...existing };\nfor (const field of ['unusedCapacity','targetReservations','maximumBudgetPaise','maximumDiscountPercent','maximumExpectedCpaPaise','startTime','endTime']) { if (!extractedMissing.has(field) && intent[field] !== undefined) merged[field] = intent[field]; }\nmerged.spotId = state?.spot_id || $env.DEMO_SPOT_ID || merged.spotId;\nconst required = ['spotId','startTime','endTime','unusedCapacity','targetReservations','maximumBudgetPaise','maximumDiscountPercent','maximumExpectedCpaPaise'];\nconst missing = required.filter((field) => merged[field] === undefined || merged[field] === null || merged[field] === '');\nconst questions = { spotId: 'Which Spot is this campaign for?', startTime: 'When should the quiet slot start?', endTime: 'When should the quiet slot end?', unusedCapacity: 'How much unused capacity should we fill?', targetReservations: 'How many reservations should we target?', maximumBudgetPaise: 'What is the maximum campaign budget?', maximumDiscountPercent: 'What is the maximum discount percentage?', maximumExpectedCpaPaise: 'What is the maximum expected CPA?' };\nconst nextField = missing[0] ?? null;\nreturn [{ json: { event, existingState: state, merged, missing, nextField, question: nextField ? questions[nextField] : null, complete: missing.length === 0 } }];"
