        "jsCode": "const result = $json;\nif (!result || typeof result.campaignId !== 'string' || !result.performance) {\n  return [{ json: { ok: false, workflow: 'reservation-performance', status: 'failed', data: {}, errors: [{ code: result?.code ?? 'RESERVATION_STAGE_FAILED', message: result?.error ?? 'Reservation stage did not return performance' }] } }];\n}\nreturn [{ json: { ok: true, workflow: 'reservation-performance', status: 'completed', data: { campaignId: result.campaignId, reservationId: result.reservationId, isDemoBooking: result.isDemoBooking, performance: result.performance }, errors: [] } }];"
