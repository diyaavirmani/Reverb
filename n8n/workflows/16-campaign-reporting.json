{
  "name": "Reverb Fill - 16 Campaign Reporting",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "reverb/report",
        "responseMode": "responseNode",
        "options": {}
      },
      "id": "16000000-0000-4000-8000-000000000001",
      "name": "Receive Report Request",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2.1,
      "position": [-840, 0],
      "webhookId": "16000000-0000-4000-8000-000000000501"
    },
    {
      "parameters": {
        "jsCode": "const body = $json.body ?? $json;\nreturn [{ json: { payload: { campaignId: body.campaignId } } }];"
      },
      "id": "16000000-0000-4000-8000-000000000002",
      "name": "Normalize Report Request",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [-620, 0]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ ($env.APP_URL || 'http://127.0.0.1:3000') + '/api/demo/report' }}",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ $json.payload }}",
        "options": {}
      },
      "id": "16000000-0000-4000-8000-000000000003",
      "name": "Call Report Stage API",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [-380, 0],
      "onError": "continueRegularOutput"
    },
    {
      "parameters": {
        "jsCode": "const result = $json;\nif (!result || typeof result.campaignId !== 'string' || !result.performance) {\n  return [{ json: { ok: false, workflow: 'campaign-reporting', status: 'failed', data: {}, errors: [{ code: result?.code ?? 'REPORT_STAGE_FAILED', message: result?.error ?? 'Report stage did not return campaign performance' }] } }];\n}\nreturn [{ json: { ok: true, workflow: 'campaign-reporting', status: 'completed', data: { campaignId: result.campaignId, campaignStatus: result.campaignStatus, performance: result.performance, reservationCount: result.reservationCount }, errors: [] } }];"
      },
      "id": "16000000-0000-4000-8000-000000000004",
      "name": "Format Report Response",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [-140, 0]
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ $json }}",
        "options": {
          "responseCode": "={{ $json.ok ? 200 : 400 }}"
        }
      },
      "id": "16000000-0000-4000-8000-000000000005",
      "name": "Respond Report Result",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.4,
      "position": [100, 0]
    }
  ],
  "connections": {
