ed: ['campaignId'], allowed: ['campaignId'] },\n  save_transaction: { required: ['id','campaignId','ownerApprovalId','providerId','packageId','status','currency','amountPaise','idempotencyKey','createdAt','updatedAt'], allowed: ['id','campaignId','ownerApprovalId','providerId','packageId','status','currency','amountPaise','idempotencyKey','checkoutAttemptedAt','merchantOrderId','createdAt','updatedAt'] },\n  get_transaction: { required: ['campaignId'], allowed: ['campaignId'] },\n  save_merchant_order: { required: ['id','transactionId','providerId','status','currency','amountPaise','createdAt','updatedAt'], allowed: ['id','transactionId','providerId','externalMerchantOrderId','status','currency','amountPaise','scheduledStartAt','scheduledEndAt','paidAt','createdAt','updatedAt'] },\n  get_merchant_order: { required: ['id'], allowed: ['id'] },\n  save_reservation: { required: ['id','campaignId','spotId','source','customerReference','seatCount','reservationAt','attributedAt','status','isTest'], allowed: ['id','campaignId','activationId','spotId','source','customerReference','seatCount','reservationAt','attributedAt','status','isTest','testLabel'] },\n  list_reservations: { required: ['campaignId'], allowed: ['campaignId'] },\n  append_audit_event: { required: ['campaign_id','event_type','description'], allowed: ['campaign_id','event_type','description','metadata','id','actorType','actorId','occurredAt','idempotencyKey','previousState','nextState'] },\n  list_audit_events: { required: ['campaignId'], allowed: ['campaignId'] }\n};\nconst operation = request.operation;\nconst config = configs[operation];\nif (!config) throw new Error('Unsupported storage operation');\nif (typeof request.request_id !== 'string' || request.request_id.trim() === '') throw new Error('request_id is required');\nconst sourceRecords = config.many ? (Array.isArray(request.data) ? request.data : [request.data]) : [request.data ?? {}];\nif (sourceRecords.length === 0) throw new Error('At least one record is required');\nreturn sourceRecords.map((source) => {\n  if (!source || typeof source !== 'object' || Array.isArray(source)) throw new Error('Operation data must be an object');\n  for (const field of config.required) if (source[field] === undefined || source[field] === null || source[field] === '') throw new Error(`Missing required field: ${field}`);\n  let row = {};\n  for (const field of config.allowed) if (source[field] !== undefined) row[field] = typeof source[field] === 'object' ? JSON.stringify(source[field]) : source[field];\n  if (operation === 'append_audit_event') {\n    const metadata = source.metadata && typeof source.metadata === 'object' && !Array.isArray(source.metadata) ? source.metadata : {};\n    row = { id: source.id ?? request.request_id, entityType: 'Campaign', entityId: source.campaign_id, eventType: source.event_type, actorType: source.actorType ?? 'SYSTEM', actorId: source.actorId ?? 'n8n', occurredAt: source.occurredAt ?? new Date().toISOString(), idempotencyKey: source.idempotencyKey ?? request.request_id, previousState: source.previousState ?? '', nextState: source.nextState ?? '', metadata: JSON.stringify({ ...metadata, description: source.description }) };\n  }\n  return { json: { operation, request_id: request.request_id, ...row } };\n});"
