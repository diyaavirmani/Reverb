      "actual": {
        "campaignCreated": true,
        "spot": "Quiet Cup Cafe",
        "unusedCapacity": 12,
        "targetReservations": 6,
        "maximumBudgetPaise": 500000,
        "maximumCpaPaise": 85000
      },
      "expected": {
        "campaignCreated": true,
        "spot": "Quiet Cup Cafe",
